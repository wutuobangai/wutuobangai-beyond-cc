{
  "_comment": "Example settings.json for Claude Code with anti-reverse-pushback hook installed",
  "_install_steps": [
    "1. Copy hooks/anti-reverse-pushback.sh to ~/.claude/hooks/",
    "2. chmod +x ~/.claude/hooks/anti-reverse-pushback.sh",
    "3. Merge the 'hooks' block below into your ~/.claude/settings.json",
    "4. Restart Claude Code (claude restart or quit GUI and reopen)"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/anti-reverse-pushback.sh",
            "_comment": "Stage-10 reverse pushback · intercepts 17 escalation triggers · injects light-vs-heavy comparison prompt"
          }
        ]
      }
    ]
  }
}
